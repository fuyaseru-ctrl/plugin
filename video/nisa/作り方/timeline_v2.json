 "captions": [
  {
   "i": 0,
   "text": "フヤセルAI【新NISA枠の相談室】で",
   "start": 0.9,
   "end": 4.42
  },
  {
   "i": 1,
   "text": "できることを、ご紹介します",
   "start": 4.42,
   "end": 6.58
  },
  {
   "i": 2,
   "text": "「枠を使うのが、もったいない」",
   "start": 6.58,
   "end": 9.22
  },
  {
   "i": 3,
   "text": "「何を入れればいいか、分からない」",
   "start": 9.22,
   "end": 12.5
  },
  {
   "i": 4,
   "text": "そんな迷いで、止まっていませんか",
   "start": 12.5,
   "end": 15.54
  },
  {
   "i": 5,
   "text": "枠をどこに・いつ・どう使うか",
   "start": 15.54,
   "end": 19.14
  },
  {
   "i": 6,
   "text": "ChatGPTが、一緒に決めます",
   "start": 19.14,
   "end": 21.57
  },
  {
   "i": 7,
   "text": "使い方は、とてもかんたんです",
   "start": 22.47,
   "end": 25.27
  },
  {
   "i": 8,
   "text": "入力欄の左の「＋」から選んで",
   "start": 25.27,
   "end": 28.15
  },
  {
   "i": 9,
   "text": "何も打たずに、送信の矢印を押すだけ",
   "start": 28.15,
   "end": 32.07
  },
  {
   "i": 10,
   "text": "よくある止まり方を5つ挙げて",
   "start": 32.07,
   "end": 35.03
  },
  {
   "i": 11,
   "text": "ほどく一言を、添えて答えます",
   "start": 35.03,
   "end": 37.31
  },
  {
   "i": 12,
   "text": "迷いは、決まりと数字でほどきます",
   "start": 38.32,
   "end": 41.64
  },
  {
   "i": 13,
   "text": "たとえば「損したら、枠が無駄になる」",
   "start": 41.64,
   "end": 45.72
  },
  {
   "i": 14,
   "text": "実は、売った株の生涯の枠は",
   "start": 45.72,
   "end": 48.76
  },
  {
   "i": 15,
   "text": "買った値段の分だけ、翌年に戻ります",
   "start": 48.76,
   "end": 52.2
  },
  {
   "i": 16,
   "text": "思い込みを、1つずつ外していきます",
   "start": 52.2,
   "end": 54.88
  },
  {
   "i": 17,
   "text": "最後は「NISA作戦メモ」にまとめます",
   "start": 55.56,
   "end": 59.4
  },
  {
   "i": 18,
   "text": "止まっている所と、ほどく一言",
   "start": 59.4,
   "end": 63.16
  },
  {
   "i": 19,
   "text": "NISAに置く株と、特定口座に置く株",
   "start": 63.16,
   "end": 67.32
  },
  {
   "i": 20,
   "text": "今年やることと、来年1月にやること",
   "start": 67.32,
   "end": 71.48
  },
  {
   "i": 21,
   "text": "売り方の決まりと、次の1手",
   "start": 71.48,
   "end": 74.84
  },
  {
   "i": 22,
   "text": "次の1手は、日付つきで1つだけ",
   "start": 74.84,
   "end": 77.88
  },
  {
   "i": 23,
   "text": "気になる銘柄があれば",
   "start": 79.0,
   "end": 80.6
  },
  {
   "i": 24,
   "text": "銘柄名か銘柄コードを送るだけ",
   "start": 80.6,
   "end": 83.96
  },
  {
   "i": 25,
   "text": "NISAか、特定口座か",
   "start": 83.96,
   "end": 86.2
  },
  {
   "i": 26,
   "text": "置き場所と、買い方・売り方を答えます",
   "start": 86.2,
   "end": 90.04
  },
  {
   "i": 27,
   "text": "NISAの画面の画像を、貼って送っても",
   "start": 90.04,
   "end": 92.92
  },
  {
   "i": 28,
   "text": "残りの枠や持ち株を、読み取って答えます",
   "start": 92.92,
   "end": 95.88
  },
  {
   "i": 29,
   "text": "年末の、枠の締めの日",
   "start": 96.78,
   "end": 99.58
  },
  {
   "i": 30,
   "text": "前のNISAの株の、期限",
   "start": 99.58,
   "end": 102.38
  },
  {
   "i": 31,
   "text": "配当の受け取り方",
   "start": 102.38,
   "end": 104.54
  },
  {
   "i": 32,
   "text": "家族に残す時のことまで",
   "start": 104.54,
   "end": 107.1
  },
  {
   "i": 33,
   "text": "落とし穴も、先回りして答えます",
   "start": 107.1,
   "end": 110.38
  },
  {
   "i": 34,
   "text": "答えの最後の番号を送れば",
