 "captions": [
  {
   "i": 0,
   "text": "フヤセルAI【年末の節税売り】で",
   "start": 0.9,
   "end": 4.62
  },
  {
   "i": 1,
   "text": "できることを、ご紹介します",
   "start": 4.62,
   "end": 7.06
  },
  {
   "i": 2,
   "text": "「含み損の株、どうしよう」",
   "start": 7.06,
   "end": 9.66
  },
  {
   "i": 3,
   "text": "「どの株を、いつ売ればいい？」",
   "start": 9.66,
   "end": 12.5
  },
  {
   "i": 4,
   "text": "そんな迷い、ありませんか",
   "start": 12.5,
   "end": 15.06
  },
  {
   "i": 5,
   "text": "得になるか・どの株を・いつ売るか",
   "start": 15.06,
   "end": 18.26
  },
  {
   "i": 6,
   "text": "ChatGPTが、一緒に決めます",
   "start": 18.26,
   "end": 20.58
  },
  {
   "i": 7,
   "text": "使い方は、とてもかんたんです",
   "start": 21.47,
   "end": 24.11
  },
  {
   "i": 8,
   "text": "入力欄の左の「＋」から選んで",
   "start": 24.11,
   "end": 26.91
  },
  {
   "i": 9,
   "text": "何も打たずに、送信の矢印を押すだけ",
   "start": 26.91,
   "end": 30.67
  },
  {
   "i": 10,
   "text": "今年の数字の見方から",
   "start": 30.67,
   "end": 32.67
  },
  {
   "i": 11,
   "text": "売る株の分け方まで、答えます",
   "start": 32.67,
   "end": 34.95
  },
  {
   "i": 12,
   "text": "含み損の株を、年内に売ると",
   "start": 35.88,
   "end": 38.76
  },
  {
   "i": 13,
   "text": "今年の利益から、損が差し引かれます",
   "start": 38.76,
   "end": 41.88
  },
  {
   "i": 14,
   "text": "すると、引かれていた税が",
   "start": 41.88,
   "end": 43.96
  },
  {
   "i": 15,
   "text": "口座に戻ってくることがあります",
   "start": 43.96,
   "end": 46.52
  },
  {
   "i": 16,
   "text": "たとえば、今年の利益が30万円で",
   "start": 46.52,
   "end": 49.96
  },
  {
   "i": 17,
   "text": "20万円の損を出すと",
   "start": 49.96,
   "end": 52.16
  },
  {
   "i": 18,
   "text": "約4万円の税が、戻る見込みです",
   "start": 52.16,
   "end": 55.72
  },
  {
   "i": 19,
   "text": "戻る税の見立ても、計算つきで答えます",
   "start": 55.72,
   "end": 58.68
  },
  {
   "i": 20,
   "text": "最後は「節税売りメモ」にまとめます",
   "start": 59.6,
   "end": 62.88
  },
  {
   "i": 21,
   "text": "今年の数字と、戻る税の見立て",
   "start": 62.88,
   "end": 66.24
  },
  {
   "i": 22,
   "text": "売る株と、持ち続ける株",
   "start": 66.24,
   "end": 68.96
  },
  {
   "i": 23,
   "text": "売る日と、買い直す日の段取り",
   "start": 68.96,
   "end": 71.84
  },
  {
   "i": 24,
   "text": "申告が要るかどうかと、点検",
   "start": 71.84,
   "end": 74.96
  },
  {
   "i": 25,
   "text": "次の1手は、日付つきで1つだけ",
   "start": 74.96,
   "end": 77.88
  },
  {
   "i": 26,
   "text": "気になる銘柄があれば",
   "start": 78.97,
   "end": 80.49
  },
  {
   "i": 27,
   "text": "銘柄名か銘柄コードを送るだけ",
   "start": 80.49,
   "end": 83.69
  },
  {
   "i": 28,
   "text": "この株をどうするかと",
   "start": 83.69,
   "end": 85.61
  },
  {
   "i": 29,
   "text": "売る日・買い直す日を、答えます",
   "start": 85.61,
   "end": 88.73
  },
  {
   "i": 30,
   "text": "証券会社の画面の画像を",
   "start": 88.73,
   "end": 90.77
  },
  {
   "i": 31,
   "text": "貼って送っても",
   "start": 90.77,
   "end": 92.25
  },
  {
   "i": 32,
   "text": "今年の利益や持ち株を、読み取ります",
   "start": 92.25,
   "end": 94.68
  },
  {
   "i": 33,
   "text": "年末の、締めの日",
   "start": 95.6,
   "end": 97.76
  },
  {
   "i": 34,
   "text": "配当や優待の、権利の日",
   "start": 97.76,
   "end": 101.04
  },
  {
   "i": 35,
   "text": "申告すると、上がることがある保険料",
   "start": 101.04,
   "end": 104.8
  },
  {
   "i": 36,
   "text": "扶養や、優待の年数のことまで",
   "start": 104.8,
   "end": 108.08
  },
  {
   "i": 37,
   "text": "落とし穴も、先回りして答えます",
   "start": 108.08,
   "end": 111.12
  },
  {
   "i": 38,
   "text": "答えの最後の番号を送れば",
   "start": 111.12,
   "end": 113.64
  },
  {
   "i": 39,
   "text": "続きも、すぐに聞けます",
   "start": 113.64,
   "end": 115.25
  },
  {
   "i": 40,
   "text": "年末の「どうしよう」を",
   "start": 115.93,
   "end": 118.49
  },
  {
   "i": 41,
   "text": "次の1手に、変えていきましょう",
   "start": 118.49,
   "end": 121.29
  },
  {
   "i": 42,
