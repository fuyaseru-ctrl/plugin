   "text": "今の株価との差",
   "start": 54.39,
   "end": 56.47
  },
  {
   "i": 18,
   "text": "買い方と、手仕舞いの目安",
   "start": 56.47,
   "end": 58.79
  },
  {
   "i": 19,
   "text": "気をつけることまで、まとめて届きます",
   "start": 58.79,
   "end": 61.17
  },
  {
   "i": 20,
   "text": "判断は、3つの段階で出ます",
   "start": 61.75,
   "end": 65.11
  },
  {
   "i": 21,
   "text": "物差しは、大株主の買値との差",
   "start": 65.11,
   "end": 69.11
  },
  {
   "i": 22,
   "text": "買値に近いほど前向きに",
   "start": 69.11,
   "end": 71.99
  },
  {
   "i": 23,
   "text": "離れすぎていれば、見送りと答えます",
   "start": 71.99,
   "end": 75.99
  },
  {
   "i": 24,
   "text": "大株主が売った時や、大きな増配の後など",
