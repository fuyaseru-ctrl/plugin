 "captions": [
  {
   "i": 0,
   "text": "フヤセルAI【会話引継ぎ】で",
   "start": 0.9,
   "end": 3.74
  },
  {
   "i": 1,
   "text": "できることを、ご紹介します",
   "start": 3.74,
   "end": 5.74
  },
  {
   "i": 2,
   "text": "「会話が長くなって、答えがずれてきた」",
   "start": 5.74,
   "end": 9.38
  },
  {
   "i": 3,
   "text": "「前に話した持ち株を、また聞かれた」",
   "start": 9.38,
   "end": 13.22
  },
  {
   "i": 4,
   "text": "そんな時に、新しいチャットへ渡す1枚を",
   "start": 13.22,
   "end": 16.98
  },
  {
   "i": 5,
   "text": "ChatGPTが作ります",
   "start": 16.98,
   "end": 18.86
  },
  {
   "i": 6,
   "text": "使い方は、とてもかんたんです",
   "start": 19.74,
   "end": 22.54
  },
  {
   "i": 7,
   "text": "引き継ぎたい会話の中で",
   "start": 22.54,
   "end": 24.62
  },
  {
   "i": 8,
   "text": "入力欄の左の「＋」から選んで",
   "start": 24.62,
   "end": 27.66
  },
  {
   "i": 9,
   "text": "何も打たずに、送信の矢印を押すだけ",
   "start": 27.66,
   "end": 31.58
  },
  {
   "i": 10,
   "text": "引継ぎの1枚が、枠の中に出ます",
   "start": 31.58,
   "end": 34.43
  },
  {
   "i": 11,
   "text": "相談の目的と、決まったこと",
   "start": 35.44,
   "end": 38.36
  },
  {
   "i": 12,
   "text": "持ち株、買値、使えるお金",
   "start": 38.36,
   "end": 41.88
  },
  {
   "i": 13,
   "text": "最後の判断と、まだ決まっていないこと",
   "start": 41.88,
   "end": 45.48
  },
  {
   "i": 14,
   "text": "新しいチャットで、最初にやること",
   "start": 45.48,
   "end": 48.6
  },
  {
   "i": 15,
   "text": "数字には、確かめた日も添えます",
   "start": 48.6,
   "end": 51.72
  },
  {
   "i": 16,
   "text": "大事なことを、分けて1枚にまとめます",
   "start": 51.72,
   "end": 54.9
  },
  {
   "i": 17,
   "text": "枠の右上の、コピーを押して",
   "start": 55.833,
   "end": 58.5
  },
  {
   "i": 18,
   "text": "新しいチャットに、貼って送るだけ",
   "start": 58.5,
   "end": 61.14
  },
  {
   "i": 19,
   "text": "「引継ぎを受け取りました」と答えて",
   "start": 61.14,
   "end": 64.26
  },
  {
   "i": 20,
   "text": "数字を最新に、確かめ直してから",
   "start": 64.26,
   "end": 67.26
  },
  {
   "i": 21,
   "text": "前の続きから、答えてくれます",
   "start": 67.26,
   "end": 69.94
  },
  {
   "i": 22,
   "text": "使っていたフヤセルAIも",
   "start": 69.94,
   "end": 72.34
  },
  {
   "i": 23,
   "text": "「＋」から選べば、同じ考え方で続きます",
   "start": 72.34,
   "end": 75.37
  },
  {
   "i": 24,
   "text": "前に決めたことを、忘れている",
   "start": 76.25,
   "end": 79.13
  },
  {
   "i": 25,
   "text": "同じことを、何度も聞かれる",
   "start": 79.13,
   "end": 81.93
  },
  {
   "i": 26,
   "text": "答えがずれたり、遅くなったりする",
   "start": 81.93,
   "end": 85.13
  },
  {
   "i": 27,
   "text": "そんな合図が出たら、引き継ぎどきです",
   "start": 85.13,
   "end": 87.57
  },
  {
   "i": 28,
   "text": "1枚の後には",
   "start": 88.41,
   "end": 89.85
  },
  {
   "i": 29,
   "text": "「次に聞くと良いこと」が3つ出ます",
   "start": 89.85,
   "end": 93.29
  },
  {
   "i": 30,
   "text": "「1」を送れば、もっと短い1枚に",
   "start": 93.29,
   "end": 96.93
  },
  {
   "i": 31,
   "text": "番号を送るだけで、続きが聞けます",
   "start": 96.93,
   "end": 99.46
  },
  {
   "i": 32,
   "text": "会話が長くなっても",
   "start": 100.29,
   "end": 101.93
  },
  {
   "i": 33,
   "text": "大事なことは、1枚で引き継げます",
   "start": 101.93,
   "end": 105.17
  },
  {
   "i": 34,
   "text": "フヤセルAI【会話引継ぎ】を",
   "start": 105.17,
   "end": 108.05
  },
  {
   "i": 35,
   "text": "長い相談の味方に、してみてください",
